# Copy to .env and fill in. .env is gitignored - it holds real credentials.
#
# Anything already exported in your shell wins over what is set here, so a
# one-off run can be steered from the command line without editing this file.

# The local break-glass account created at first boot.
ADMIN_USERNAME=SAGAdmin
ADMIN_PASSWORD=

TAILSCALE_AUTH_KEY=

# COMPUTER_NAME is prompted for if left unset, which is usually what you want
# since it differs per machine.
#COMPUTER_NAME=SAG-AIR12-LITE-101

# Wifi networks. Numbered so passphrases can contain any character. Every one
# listed is pre-seeded onto the machine, so it works at more than one site.
# Omit entirely if the machine is wired.
#WIFI_1_SSID=FireFlood
#WIFI_1_PASSWORD=
#WIFI_2_SSID=GDM
#WIFI_2_PASSWORD=

#TAILSCALE_TAGS=tag:clinic-workstation
#TIMEZONE=Pacific Standard Time
