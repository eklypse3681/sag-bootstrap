
# generated unattend output - contains plaintext credentials
unattend/out/
unattend/*.generated.*
Autounattend.xml

# unattend: real credentials and network keys
unattend/.env
unattend/wifi/*.xml
!unattend/wifi/.gitkeep

# editor swap/backup files - a vim swap of a .env holds the live buffer,
# credentials and all
*.swp
*.swo
*.swn
*~
.*.sw?
